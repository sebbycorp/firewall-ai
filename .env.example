# Copy to .env locally. Never commit real values.
# See SECURITY.md — PAN-OS API keys stay on the student agent only.

# ---------------------------------------------------------------------------
# Controller (Cloud Run / local)
# ---------------------------------------------------------------------------
STORE_BACKEND=memory
# GCP project id (required when STORE_BACKEND=firestore)
GCP_PROJECT=firewall-ai
# Shared class enrollment key. Rotate between terms.
ENROLLMENT_KEY=replace-me-class-enrollment-key
# Instructor UI + admin API bearer token.
ADMIN_TOKEN=replace-me-admin-token
# Mark a lab offline if last_seen is older than this (seconds).
OFFLINE_AFTER_SEC=120
# Optional: bind locally
PORT=8080

# ---------------------------------------------------------------------------
# Student agent (docker compose on the management LAN)
# ---------------------------------------------------------------------------
CONTROLLER_URL=https://YOUR-CLOUD-RUN-SERVICE-XXXX.a.run.app
# Same class enrollment key the instructor issued. AGENT_TOKEN is accepted as an alias.
ENROLLMENT_KEY=replace-me-class-enrollment-key
STUDENT_ID=your.name@sheridancollege.ca
# Management IP or hostname of the local PA-VM
FW_HOST=https://172.16.10.222
# XML API key generated on the PA-VM. Used only by this agent. Never send to the controller.
FW_API_KEY=YOUR_PANOS_XML_API_KEY
HEARTBEAT_INTERVAL_SEC=30
# Lab VMs almost always use a self-signed cert
FW_VERIFY_TLS=false
# Optional: skip enroll if you already have a per-agent credential
# AGENT_ID=
# AGENT_TOKEN=
